# StockSync Environment Variables
# Copy this file to .env and fill in your values.

# JWT Settings (shared by auth-service and every service that validates tokens)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256

# Service-to-service authentication (sync -> catalog, sales, integrations)
INTERNAL_SERVICE_SECRET=your-internal-service-secret-change-in-production

# Mercado Livre API (integrations-service)
MERCADO_LIVRE_APP_ID=your-mercado-livre-app-id
MERCADO_LIVRE_CLIENT_SECRET=your-mercado-livre-client-secret
# Public base URL used for the OAuth redirect and the webhook callback.
PUBLIC_API_URL=http://localhost:8003
# URL-safe token embedded in the webhook callback URL. Required when DEBUG=false.
ML_WEBHOOK_SECRET=change-me-url-safe-token
ML_WEBHOOK_DEDUP_TTL_SECONDS=3600
# Lifetime (seconds) of the signed, single-use OAuth state nonce.
OAUTH_STATE_TTL_SECONDS=600
# Mercado Livre token refresh lock (Redis) and refresh window.
ML_REFRESH_LOCK_TTL_SECONDS=15
ML_REFRESH_LOCK_TIMEOUT_SECONDS=10
ML_REFRESH_BUFFER_SECONDS=600

# Shopee API (integrations-service)
SHOPEE_PARTNER_ID=your-shopee-partner-id
SHOPEE_PARTNER_KEY=your-shopee-partner-key

# Cloudinary Configuration (integrations-service & frontend)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
