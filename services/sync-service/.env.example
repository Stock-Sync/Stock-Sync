APP_NAME=sync-service
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stocksync_sync
DB_ECHO=false
REDIS_URL=redis://localhost:6379/0
CATALOG_SERVICE_URL=http://localhost:8001
INTEGRATIONS_SERVICE_URL=http://localhost:8003
SALES_SERVICE_URL=http://localhost:8004

# JWT Settings (must match auth-service so the tenant can be resolved)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256

# Shared secret for internal calls from sync-service (X-Internal-Secret)
INTERNAL_SERVICE_SECRET=your-internal-service-secret-change-in-production

# Threshold ratio for reconciliation soft-deletes (0.10 = 10%)
SYNC_SAFETY_THRESHOLD_RATIO=0.10
