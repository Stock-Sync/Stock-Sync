APP_NAME=integrations-service
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stocksync_integrations
DB_ECHO=false
REDIS_URL=redis://localhost:6379/0
MERCADO_LIVRE_APP_ID=
MERCADO_LIVRE_CLIENT_SECRET=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Public base URL used for the OAuth redirect + webhook callback
PUBLIC_API_URL=http://localhost:8003
FRONTEND_URL=http://localhost:5173

# Shared secret embedded in the webhook callback URL (URL-safe characters).
# Required when DEBUG=false.
ML_WEBHOOK_SECRET=change-me-url-safe-token
ML_WEBHOOK_DEDUP_TTL_SECONDS=3600
# Lifetime (seconds) of the signed, single-use OAuth state nonce.
OAUTH_STATE_TTL_SECONDS=600

# Mercado Livre token refresh distributed lock (Redis) and refresh window.
# Lock TTL bounds a crashed holder; timeout is how long a waiter polls.
ML_REFRESH_LOCK_TTL_SECONDS=15
ML_REFRESH_LOCK_TIMEOUT_SECONDS=10
# Refresh tokens within this window before they expire (10 minutes).
ML_REFRESH_BUFFER_SECONDS=600

# JWT Settings (must match auth-service so the tenant can be resolved)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256

# Shared secret for internal calls from sync-service (X-Internal-Secret)
INTERNAL_SERVICE_SECRET=your-internal-service-secret-change-in-production
# Base URL of catalog-service used by the listing creation/deletion saga
CATALOG_SERVICE_URL=http://localhost:8001

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
