APP_NAME=catalog-service
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stocksync_catalog
DB_ECHO=false
REDIS_URL=redis://localhost:6379/0

# JWT Settings (must match auth-service so the tenant can be resolved)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256

# Shared secret for internal calls from sync-service (X-Internal-Secret)
INTERNAL_SERVICE_SECRET=your-internal-service-secret-change-in-production

# Used by the orchestrated unbind/re-link flows (Plan 9)
INTEGRATIONS_SERVICE_URL=http://localhost:8003
